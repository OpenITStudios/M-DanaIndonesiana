{
  "schema": 1,
  "purpose": "Synthetic decision table; an advisory tool cannot attest user consent",
  "defaults": {
    "repository": "OpenITStudios/M-DanaIndonesiana",
    "branch": "develop",
    "head_sha": "1111111111111111111111111111111111111111",
    "mode": "INSPECT",
    "action": "read_repo",
    "path": "AGENTS.md",
    "data_class": "PUBLIC_SYSTEM",
    "user_authorized": false,
    "source_authorized": false,
    "persist_requested": false
  },
  "cases": [
    {
      "id": "P01-read",
      "overrides": {},
      "expected": {
        "decision": "ALLOW",
        "reason": "REPO_READ_ONLY"
      }
    },
    {
      "id": "P02-write",
      "overrides": {
        "mode": "SYSTEM_DEVELOPMENT",
        "action": "write_repo",
        "path": "tools/finance-report.mjs",
        "user_authorized": true
      },
      "expected": {
        "decision": "ALLOW",
        "reason": "REPO_WRITE_CONDITIONAL"
      }
    },
    {
      "id": "P03-local",
      "overrides": {
        "mode": "SYSTEM_DEVELOPMENT",
        "action": "write_repo",
        "path": "tools/finance-report.mjs",
        "branch": "Local",
        "user_authorized": true
      },
      "expected": {
        "decision": "BLOCK",
        "reason": "WRITE_REQUIRES_DEVELOP"
      }
    },
    {
      "id": "P04-main",
      "overrides": {
        "mode": "SYSTEM_DEVELOPMENT",
        "action": "write_repo",
        "path": "README.md",
