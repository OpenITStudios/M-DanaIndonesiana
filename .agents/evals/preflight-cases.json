      "expected": {
        "decision": "BLOCK",
        "reason": "UNSAFE_OR_UNOWNED_PATH"
      }
    },
    {
      "id": "P06-absolute",
      "overrides": {
        "mode": "SYSTEM_DEVELOPMENT",
        "action": "write_repo",
        "path": "/tmp/file",
        "user_authorized": true
      },
      "expected": {
        "decision": "BLOCK",
        "reason": "UNSAFE_OR_UNOWNED_PATH"
      }
    },
    {
